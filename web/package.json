{
  "name": "solarxy-web-frontend",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "build:wasm": "bash ../crates/solarxy-web/build-wasm.sh web/src/wasm/pkg",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "notices": "node -e \"require('fs').copyFileSync('../THIRD-PARTY-NOTICES.md','public/THIRD-PARTY-NOTICES.md')\"",
    "prebuild": "npm run notices",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lezer/highlight": "^1.2.3",
    "@sentry/browser": "^10.65.0",
    "@xyflow/react": "^12.8.5",
    "dockview-react": "^7.0.2",
    "elkjs": "^0.9.3",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
