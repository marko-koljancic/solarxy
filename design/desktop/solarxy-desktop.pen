            },
            {
              "type": "frame",
              "id": "MItDK",
              "name": "Mesh rows must keep the material pairing",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 2,
              "children": [
                {
                  "type": "text",
                  "id": "igyUm",
                  "name": "K",
                  "fill": "$ink-primary",
                  "content": "Mesh rows must keep the material pairing",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Wjyac",
                  "name": "B",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The as-is Outliner puts each mesh's material name beside it in muted ink on the same row, which is what makes Meshes and Materials read as one model. This proposal drew bare mesh names because it predated the capture. The engine variant adopts the pairing, so the two paths look identical at row level and only the object tier is new.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Kd3uK",
