                  "id": "JutKU",
                  "name": "B",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The as-is capture shows the counts line followed by severity-dotted issue rows. This proposal already matched it, and it needs no change beyond its data source.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
