                  "id": "zIEYm",
                  "name": "B",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Confirmed present in the as-is capture and kept here, disabled until something is hidden.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
