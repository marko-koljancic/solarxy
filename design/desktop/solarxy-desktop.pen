          "id": "qmIfk",
          "name": "T",
          "fill": "$state-attention",
          "content": "PROPOSED",
          "fontFamily": "$font-ui",
          "fontSize": 26,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "YQyLr",
          "name": "B",
          "fill": "$ink-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Everything below this marker is forward-looking and does not exist in the shipped app. Everything in the AS-IS bands to the left is a record of what ships today. Keeping the two physically apart is decision D-2, so that the question \"what does the desktop look like now\" can be answered without reading anything.",
          "lineHeight": 1.55,
          "fontFamily": "$font-ui",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "WF6Y3",
          "name": "C",
          "fill": "$ink-tertiary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Current contents: the three panel changes the 0.8.2 desktop engine surface introduces. Each was designed before the as-is capture existed, and each has now been checked against its captured baseline. Reconciliation notes are on the bands themselves.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    }
