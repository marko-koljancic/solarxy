        {
          "type": "frame",
          "id": "PSOgq",
          "name": "Anatomy notes",
          "width": 1064,
          "gap": 26,
          "children": [
            {
              "type": "frame",
              "id": "qSwQD",
              "name": "Monochrome, deliberately",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 3,
              "children": [
                {
                  "type": "text",
                  "id": "twCfg",
                  "name": "Key",
                  "fill": "$accent",
                  "content": "Monochrome, deliberately",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "L6bwj",
                  "name": "Body",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The web canvas fills nodes with category pastels because they are spatial cards that must be told apart at a glance. A dense text tree does not need that and would read as noise, so the tree stays neutral grey with amber for selection, like the rest of this shell.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "SKBzC",
              "name": "Selection",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 3,
              "children": [
                {
                  "type": "text",
                  "id": "nx7bo",
                  "name": "Key",
                  "fill": "$accent",
                  "content": "Selection",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ozZ65",
                  "name": "Body",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Row background only, using the shared selection token. Selecting here selects in the viewport, which is the whole point of the panel.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "J68Fa6",
              "name": "Bypass",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 3,
              "children": [
                {
                  "type": "text",
                  "id": "KUn6A",
                  "name": "Key",
                  "fill": "$accent",
                  "content": "Bypass",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "g8hbD",
                  "name": "Body",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Struck through and dimmed. Bypass is engine state a viewer must show, since a bypassed node explains a missing object.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "I6Kf0B",
              "name": "Containers",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 3,
              "children": [
                {
                  "type": "text",
                  "id": "yFuar",
                  "name": "Key",
                  "fill": "$accent",
                  "content": "Containers",
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ukydN",
                  "name": "Body",
                  "fill": "$ink-tertiary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A twisty dives into the subgraph; the breadcrumb walks back. Leaf nodes reserve the same 12px so labels stay on one left edge.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
