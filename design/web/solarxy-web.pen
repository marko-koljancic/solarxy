        {
          "type": "frame",
          "id": "m1mGP",
          "name": "Derivation rule",
          "fill": "$background-quaternary",
          "cornerRadius": 4,
          "layout": "vertical",
          "gap": 6,
          "padding": 14,
          "children": [
            {
              "type": "text",
              "id": "pkflJ",
              "name": "h",
              "fill": "$text-primary",
              "content": "Derivation from the RegistrySnapshot (the implementation contract)",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "j6KPZ8",
              "name": "c",
              "fill": "$text-primary",
              "content": "shapeFor(desc):",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "VnhhJ",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.typeId == \"note\"                          -> sticky       // already special-cased in code",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "nJWSY",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.category == \"container\"                   -> square       // geo",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KRZKv",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.category == \"lights\"                      -> lamp         // the 6 light types",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "mxdrC",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if !desc.outputs.some(o => o.dataType==\"geometry\") -> page         // import_image",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "cSYqd",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.outputs.length > 1                        -> trapezoid    // validate",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Q8K9W",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.inputs.some(p => p.variadic)              -> dome + (category==\"utility\" ? hexagon : rect)",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KnFgh",
              "name": "c",
              "fill": "$text-primary",
              "content": "                                                                    // switch : merge",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "ZgzsC",
              "name": "c",
              "fill": "$text-primary",
              "content": "  if desc.params.every(p => p.group==\"general\")",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Q5vhpo",
              "name": "c",
              "fill": "$text-primary",
              "content": "     && desc.bypass.mode == \"passThrough\"           -> donut        // null",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "C0F34",
              "name": "c",
              "fill": "$text-primary",
              "content": "  else                                              -> rect         // sources AND filters",
              "fontFamily": "$font-mono",
              "fontSize": 9,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "tc5p8",
              "name": "n1",
              "fill": "$text-tertiary",
              "textGrowth": "fixed-width",
              "width": 660,
              "content": "No per-type table: a node added in Rust gets its silhouette for free, so the zero-frontend-change contract holds. `note` is the only hardcoded typeId, and it already is one in the shipped code.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 10,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "F4dA7B",
              "name": "n2",
              "fill": "$text-tertiary",
              "textGrowth": "fixed-width",
              "width": 660,
              "content": "Source is NOT a shape (D-10 amended): Houdini does not distinguish generators from filters by outline either, and the missing input handle already says it. The dome is the variadic marker and appears on merge and switch alike, exactly as the reference does. Verified: merge and null are the only nodes with no params beyond the implicit `general` group, but merge is caught earlier by the variadic branch, so terminal resolves to null alone.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 10,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
