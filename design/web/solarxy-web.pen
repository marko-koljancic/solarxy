                      "fill": "$text-primary",
                      "content": "D-25  The public pages' first disclosure",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "S1lKtj",
                      "name": "D-25 body",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One pattern for any collapsed navigation on the public surfaces: a pill disclosure control in the nav row, mono uppercase, labelled by the section in view, opening a bordered panel that lists the same links the row carries. Adopted for the roadmap page only in 0.8.2; the helper is shared, and the landing and references pages keep their static navs until they need it.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
