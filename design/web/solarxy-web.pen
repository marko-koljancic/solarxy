                    {
                      "type": "text",
                      "id": "syEnb",
                      "name": "b",
                      "fill": "$text-tertiary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Shared helper in the public chrome module beside theme, reveal, rail, and year. It collapses only when a nav carries more links than fit the row, so the references page (three links) and the landing page never change.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
