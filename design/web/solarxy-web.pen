    {
      "type": "frame",
      "id": "V0R4D",
      "x": 7966,
      "y": 907,
      "name": "15-02 Camera look and LUT slots (0.8.2)",
      "theme": {
        "gen": "evo",
        "mode": "dark"
      },
      "fill": "$background-primary",
      "layout": "vertical",
      "gap": 18,
      "padding": 24,
      "children": [
        {
          "type": "text",
          "id": "klaCH",
          "name": "Sheet title",
          "fill": "$text-primary",
          "content": "Camera look and LUT slots (0.8.2)",
          "fontFamily": "$font-ui",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "p6GYuA",
          "name": "cap",
          "fill": "$text-tertiary",
          "textGrowth": "fixed-width",
          "width": 900,
          "content": "The camera node owns the look, so a shot's rendering intent lives in the document and survives save and load. Two LUT slots do different jobs and applying either in the wrong one produces a wrong image, so they are never labelled just LUT: each carries its colour space in the label and a one-line hint. The pipeline strip above the rows is the disambiguator, showing where each slot sits relative to the tone map.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "ak0SH",
          "name": "Pipeline",
          "fill": "$background-secondary",
          "stroke": "$border-primary",
          "strokeWidth": 1,
          "padding": [
            10,
            14
