                      "id": "Fia6n",
                      "name": "b",
                      "fill": "$text-tertiary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Focus is visible on the control and on every item in both themes, drawn with the focus token (2px). The open control carries the focus ring; the TO 1.0 row shows the item state.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
