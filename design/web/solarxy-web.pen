                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "At 390px nothing clips and the page body never scrolls sideways. The two sticky elements and the statistics band are checked at phone height as part of verification.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
