                  "width": 16,
                  "height": 16
                },
                {
                  "type": "frame",
                  "id": "W2B94",
                  "x": 120,
                  "y": 2,
                  "name": "LabelBlock",
                  "layout": "vertical",
                  "gap": 1,
                  "children": [
                    {
                      "type": "text",
                      "id": "n3FiDg",
                      "name": "TypeLabel",
                      "fill": "$evo-type-label",
                      "content": "Text",
                      "fontFamily": "Inter",
                      "fontSize": 9,
                      "fontWeight": "normal"
                    },
                    {
