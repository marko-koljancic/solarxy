                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Breakpoint 860px, an existing layout threshold on this page. At and above it the full link row renders exactly as today; the collapse is a layout change, per the design language's breakpoint rule.",
                      "lineHeight": 1.5,
