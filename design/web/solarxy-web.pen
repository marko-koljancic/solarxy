                    {
                      "type": "text",
                      "id": "aaSwU",
                      "name": "b",
                      "fill": "$text-tertiary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Active row fill and exact colours come from the public stylesheet's tokens; this sheet quotes them as literals because the editorial system, not the app token set, owns the public pages.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
