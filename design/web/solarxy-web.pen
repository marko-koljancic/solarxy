                930,
                380
              ],
              "width": 930,
              "height": 380,
              "stroke": "#FFFFFF2E",
              "strokeWidth": 1
            }
          ]
        },
        {
          "type": "text",
          "id": "e7yk33",
          "name": "d4",
          "fill": "$text-tertiary",
          "content": "REVISED 2026-08-06 (D-26/D-27): every role sits on the one 112x32 box; geo, matnet, texnet and camera are one 96x28 fixture pill inside it, pastel + glyph + label carrying the differentiation. Wings ride the bodies, revealed on hover - bypass left, display (subflow) or visibility (root) right, registry-gated - and the floating root eye is retired. Note stays the sticky (D-8).",
          "fontFamily": "$font-mono",
          "fontSize": 10,
          "fontWeight": "normal"
        }
      ]
    },
