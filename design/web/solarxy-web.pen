                      "id": "i9fwB",
                      "name": "b",
                      "fill": "$text-tertiary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Button semantics: aria-expanded and aria-controls on the control; Enter and Space toggle; Escape closes and returns focus to the control; a click outside closes.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
