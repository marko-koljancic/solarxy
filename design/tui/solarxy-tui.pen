              "name": "B",
              "fill": "$ink-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The Overview dashboard needs two tile columns and a footer key strip. Below 100 columns the tiles stack into a single column that no longer reads as a dashboard, and below 30 rows the footer starts eating the content. A stock 80 x 25 Linux console is therefore below the floor and gets the plain text report, which was always the right answer there.",
              "lineHeight": 1.55,
              "fontFamily": "$font-ui",
              "fontSize": 12,
              "fontWeight": "normal"
            }
