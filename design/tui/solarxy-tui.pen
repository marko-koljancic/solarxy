              "width": "fill_container",
              "layout": "vertical",
              "gap": 11,
              "children": [
                {
                  "type": "frame",
                  "id": "Em1Pp",
                  "name": "Double border means ",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "lGVvq",
                      "name": "T",
                      "fill": "$accent",
                      "content": "Double border means elevated",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "iLgBE",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Panels use the rounded single set, overlays the double set. Two weights carry the whole elevation language, with no shadows and no fake depth, and both survive monochrome.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "xWvMV",
                  "name": "The grid dims, it do",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "yX2t9",
                      "name": "T",
                      "fill": "$accent",
                      "content": "The grid dims, it does not vanish",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "sQod4",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The scrim reduces the background to a dim ground so context is still readable. An overlay that hides the thing it is about makes the user close it to remember why they opened it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "N1DV9",
                  "name": "esc always means bac",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "y9aGaQ",
                      "name": "T",
                      "fill": "$accent",
                      "content": "esc always means back",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "ofDEy",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Esc closes an overlay, leaves arrange mode, clears a filter, and restores from maximized, in that order of precedence. It never quits the application, which q alone does.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
