            {
              "type": "frame",
              "id": "RPgtC",
              "name": "Note",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "NGV7L",
                  "name": "Jump is the only cro",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "Ve04H",
                      "name": "T",
                      "fill": "$accent",
                      "content": "Jump is the only cross-panel action",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "P6xhB",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Everything else a panel does affects only itself. Jump deliberately breaks that, because the question a validation issue raises is always about something in another panel, and making the user find it by hand is the failure the current shell already has.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "D2Ctqo",
                  "name": "Grouping is by kind,",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "W4T1sP",
                      "name": "T",
                      "fill": "$accent",
                      "content": "Grouping is by kind, not severity",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "b6q8X",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Severity is a filter; kind is the structure. Five errors of one kind are one problem, and five of five kinds are five. The shipped shell shows a flat list that cannot tell those apart.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "D2WTZi",
                  "name": "Addresses are positi",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "A6LtRG",
                      "name": "T",
                      "fill": "$accent",
                      "content": "Addresses are positional",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "VLWNm",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Numbers follow layout order, so the tenth panel type is reachable by name from the catalogue even though only nine addresses exist at once.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-ui",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
