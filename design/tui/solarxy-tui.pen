                      "fill": "$accent",
                      "content": "IssueKind is carried and never read",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "E3vlx",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every issue has one of eleven IssueKind variants. The tab renders the Display string of the scope and the message, and drops the kind entirely. There is no grouping, no filter, no per-check summary.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "tHgCr",
                  "name": "IssueScope is flatte",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "w4Bwc",
                      "name": "T",
                      "fill": "$accent",
                      "content": "IssueScope is flattened to a string",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "TCJ2y",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The enum carries Mesh(i), Face(mesh, index), and Edge{mesh, vertices}. All of it becomes one Display call, so nothing can jump from an issue to the thing it names.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "WdFuH",
                  "name": "Materials print numb",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "godKQ",
                      "name": "T",
                      "fill": "$accent",
                      "content": "Materials print numbers, not colour",
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "s1YnL",
                      "name": "D",
                      "fill": "$ink-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ambient, diffuse and specular render as three decimals in brackets. The one place a terminal could show the actual colour, it shows arithmetic.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
