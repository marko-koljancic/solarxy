                          "type": "text",
                          "id": "bBFDA",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Below the floor the tool names its own constraint and points at the text report rather than rendering a degraded layout. A stock 80 x 25 console is below the floor, which is a stated trade rather than an oversight.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "zBkXw",
                  "name": "T-12",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "X3vDW",
                      "name": "n",
                      "fill": "$accent",
                      "content": "T-12",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "UQDDe",
                      "name": "x",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "type": "text",
                          "id": "CUzWM",
                          "name": "t",
                          "fill": "$ink-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Layout persistence mirrors DockPrefs",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-ui",
                          "fontSize": 12,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "IW62Y",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The desktop dock already solved auto-save on quit plus an explicit saved layout plus a reset that touches neither. Reusing the shape costs nothing and inherits a discipline that is already proven.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "TwWhu",
                  "name": "T-13",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "l2DEb",
                      "name": "n",
                      "fill": "$accent",
                      "content": "T-13",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "POlf4",
                      "name": "x",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "type": "text",
                          "id": "G4wfCN",
                          "name": "t",
                          "fill": "$ink-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Text reaches parity, JSON is scheduled",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-ui",
                          "fontSize": 12,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "vapHc",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The text report gains every recovered fact under an append-only rule so existing greps keep working. JSON stays behind deliberately, with a filed follow-up, so the gap is a decision with an owner rather than drift.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Y96k3Y",
                  "name": "T-14",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "nNwyW",
                      "name": "n",
                      "fill": "$accent",
                      "content": "T-14",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "V0gmTP",
                      "name": "x",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "type": "text",
                          "id": "JPMt2",
                          "name": "t",
                          "fill": "$ink-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Mouse is additive, never required",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-ui",
                          "fontSize": 12,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "e2wzp",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Drag to resize, click to focus, click a border menu. Every one has a keyboard path, so a terminal reporting no mouse loses nothing and the keyboard stays the complete interface.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ccUfv",
                  "name": "T-15",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "KVGBN",
