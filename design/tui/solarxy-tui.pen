          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "ASI4p",
              "name": "Title",
              "fill": "$ink-strong",
              "content": "PROPOSED 04  The braille panels",
              "fontFamily": "$font-ui",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "SpE76",
              "name": "Sub",
              "fill": "$ink-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Terminal dashboards spend braille on time series. An analyze report has no time axis, so it goes to spatial plots instead, which is the one thing a monitoring tool cannot draw. Two dots across and four down per cell, so a 40 by 12 panel is an 80 by 48 image.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
