          "name": "Heading",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "Ygi1Y",
              "name": "Title",
              "fill": "$ink-strong",
              "content": "PROPOSED 10  The shipped theme set",
              "fontFamily": "$font-ui",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "Cu0iP",
              "name": "Sub",
              "fill": "$ink-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Four themes ship and the user can add their own. The same reference panel in each, so the differences are structural rather than described. Every one clears the contrast floor the loader enforces, and every one degrades to identical tier 1 behaviour on a 16-colour terminal.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
