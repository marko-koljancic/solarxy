            {
              "type": "frame",
              "id": "wCnOn",
              "name": "Filter, in the border",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "ihGZb",
                  "name": "T",
                  "fill": "$accent",
                  "content": "Filter, in the border",
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "HSe84",
                  "name": "D",
                  "fill": "$ink-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Typing after / replaces the menu words with a live query and a match count. It belongs to the panel, is dismissed with esc, and never covers the rows it is filtering.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 11,
                  "fontWeight": "normal"
