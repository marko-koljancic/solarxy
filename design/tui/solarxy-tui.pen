                      "fill": "$accent",
                      "content": "T-15",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "p6JAOA",
                      "name": "x",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "type": "text",
                          "id": "afjmX",
                          "name": "t",
                          "fill": "$ink-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Everything lives in solarxy-cli behind a seam",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-ui",
                          "fontSize": 12,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "HsHvD",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The panel manager, theme system and rasteriser are what a future render dashboard needs, but designing a shared crate for a consumer that does not exist yet is the more expensive mistake. The seam is drawn and named instead.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "y9XkG",
                  "name": "T-16",
                  "width": "fill_container",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "Qe7Ck",
                      "name": "n",
                      "fill": "$accent",
                      "content": "T-16",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "F5UiIP",
                      "name": "x",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 2,
                      "children": [
                        {
                          "type": "text",
                          "id": "V1p6E8",
                          "name": "t",
                          "fill": "$ink-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Components are anatomy rules, not symbols",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-ui",
                          "fontSize": 12,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "HZ54D",
                          "name": "d",
                          "fill": "$ink-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "At character-cell granularity a border run is a function of width, so an instanced component would need a variant per width. The rules are specified and the instances are drawn.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
